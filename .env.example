# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Next.js Configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# AssemblyAI Configuration  
ASSEMBLYAI_API_KEY=your-assemblyai-api-key

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.vercel.app/api/telegram/webhook
# Secret Telegram -> server, verificato sull'header x-telegram-bot-api-secret-token del POST
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
# Secret operatore -> server per gestione manuale del webhook (GET/PUT/DELETE), MAI usato dal client.
# Va inviato come header "x-admin-secret" quando si chiama l'endpoint manualmente via curl/Postman.
TELEGRAM_WEBHOOK_ADMIN_SECRET=your-telegram-webhook-admin-secret

# AI Analysis Service
OPENROUTER_API_KEY=your-openrouter-api-key

# Email Configuration
ARUBA_EMAIL_PASSWORD=your-aruba-email-password